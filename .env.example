# Public build-time values. Set in Cloudflare Pages and rebuild to activate.
# Leave both blank for the honest pre-launch state; no emails are collected.
NEXT_PUBLIC_TESTFLIGHT_URL=
NEXT_PUBLIC_WAITLIST_ACTION=

# TESTFLIGHT_URL: the actual https://testflight.apple.com/join/... invitation.
# WAITLIST_ACTION: a real HTTPS form provider that accepts a native POST with
# fields email and source=morrow-landing and hosts its own success/error page.
# A valid TestFlight invite takes priority over the waitlist.
# Never put private API keys or credentials in NEXT_PUBLIC_ variables.
